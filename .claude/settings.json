{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\IIG\\klpp\\.claude\\pre-sync.ps1\"",
            "timeout": 60,
            "statusMessage": "Pulling latest from GitHub"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\IIG\\klpp\\.claude\\auto-push.ps1\"",
            "timeout": 60,
            "statusMessage": "Auto-commit + push",
            "async": true
          }
        ]
      }
    ]
  }
}
